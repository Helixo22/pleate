{
  "name": "pleate",
  "version": "0.1.0",
  "description": "iOS-inspired React components, design tokens and themes for Next.js and Tailwind CSS v4.",
  "license": "MIT",
  "author": "Helixo22",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Helixo22/pleate.git",
    "directory": "packages/pleate"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles/index.css",
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "default": "./dist/theme/index.js"
    },
    "./motion": {
      "types": "./dist/motion/index.d.ts",
      "default": "./dist/motion/index.js"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./ai/*": {
      "types": "./dist/ai/*/index.d.ts",
      "default": "./dist/ai/*/index.js"
    },
    "./effects/*": {
      "types": "./dist/effects/*/index.d.ts",
      "default": "./dist/effects/*/index.js"
    },
    "./marketing/*": {
      "types": "./dist/marketing/*/index.d.ts",
      "default": "./dist/marketing/*/index.js"
    },
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "default": "./dist/components/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -r src/styles dist/styles",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "palettes": "node scripts/build-palettes.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^14.5.0",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
