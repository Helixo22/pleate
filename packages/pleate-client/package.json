{
  "name": "pleate-client",
  "version": "0.1.0",
  "description": "Typed client and React hooks that connect pleate components to pleate-backend.",
  "license": "MIT",
  "author": "Helixo22",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Helixo22/pleate.git",
    "directory": "packages/pleate-client"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./mock": {
      "types": "./dist/mock/index.d.ts",
      "default": "./dist/mock/index.js"
    },
    "./mock/browser": {
      "types": "./dist/mock/browser.d.ts",
      "default": "./dist/mock/browser.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "schema": "cd ../pleate-backend && uv run python -m django spectacular --settings=tests.settings --pythonpath=. --file ../pleate-client/openapi.yml && cd ../pleate-client && npx openapi-typescript openapi.yml -o src/schema.ts",
    "test": "vitest run",
    "test:e2e": "node --test e2e/backend.e2e.mjs"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "msw": "^3.0.0",
    "pleate": "^0.1.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "msw": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "pleate": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.105.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "happy-dom": "^21.0.4",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "pleate": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
