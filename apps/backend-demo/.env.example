# Environment variables read by demo/settings.py. Export them (or load this file
# with your process manager); the demo does not read .env files by itself.

# Core. Without DEBUG=1, SECRET_KEY is required.
DEBUG=1
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# HTTPS, only read when DEBUG is off.
SECURE_PROXY_SSL_HEADER=1
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0

# Services (docker compose up -d from the repo root).
MONGODB_URI=mongodb://localhost:27027/pleate_demo?directConnection=true
REDIS_URL=
SMTP_HOST=localhost
SMTP_PORT=1025
DEFAULT_FROM_EMAIL=Plate <hello@plate.test>

# Optional integrations.
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTH=price_pro_month
STRIPE_PRICE_PRO_YEAR=price_pro_year
