{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2023"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "pleate": [
        "../../packages/pleate/src/index.ts"
      ],
      "pleate/theme": [
        "../../packages/pleate/src/theme/index.ts"
      ],
      "pleate/motion": [
        "../../packages/pleate/src/motion/index.ts"
      ],
      "pleate/lib": [
        "../../packages/pleate/src/lib/index.ts"
      ],
      "pleate/ai/*": [
        "../../packages/pleate/src/ai/*/index.ts"
      ],
      "pleate/*": [
        "../../packages/pleate/src/components/*/index.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
